# Copy to .env and fill in. Get a key at https://platform.minimax.io (Pay-as-you-go is required for H3)
MINIMAX_API_KEY=
# https://api.minimax.io for international keys, https://api.minimaxi.com for China keys
MINIMAX_API_BASE=https://api.minimax.io
# Optional access password for the Streamlit app (leave empty for no password)
APP_PASSWORD=
# Optional: bold Chinese font file for captions if the system ones are missing
FONT_PATH=
